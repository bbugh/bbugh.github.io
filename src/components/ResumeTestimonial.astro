---
interface Props {
  image: string;
  quote: string;
  name: string;
}

const { image, quote, name } = Astro.props;
---

<div
  class="mx-auto flex max-w-3xl flex-col gap-6 rounded border border-gray-200 bg-gray-100 p-6 md:flex-row"
>
  <div class="relative h-24 w-24 shrink-0">
    <img src={image} class="h-full w-full rounded-full object-cover" />
  </div>
  <div class="flex flex-col gap-1">
    <p class="leading-6">
      &ldquo;{quote}&rdquo;
    </p>
    <div class="mt-1 text-right font-bold">
      {name}
    </div>
  </div>
</div>
