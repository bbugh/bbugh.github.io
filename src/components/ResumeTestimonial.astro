---
interface Props {
  image: string;
  quote: string;
  name: string;
}

const { image, quote, name } = Astro.props;
---

<div
  class="mx-auto flex max-w-3xl flex-col gap-3 rounded border border-gray-200 bg-gray-100 p-6 md:flex-row md:gap-6"
>
  <div class="flex shrink-0 flex-col items-center gap-1 md:items-start">
    <img
      src={image}
      class="h-24 w-24 rounded-full border-2 border-gray-400 object-cover"
    />
    <div class="text-center text-sm text-gray-500 md:w-24 md:text-center">
      {name}
    </div>
  </div>
  <div class="flex flex-col gap-1">
    <p class="leading-6">
      &ldquo;{quote}&rdquo;
    </p>
  </div>
</div>
