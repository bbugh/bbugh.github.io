---
interface Props {
  title: string;
  description: string;
  years?: number;
}

const { title, description, years } = Astro.props;
---

<div>
  <h3 class="mb-1 font-serif text-xl font-semibold capitalize">
    <span set:html={title} />{
      years && <span class="font-normal"> ({years} years)</span>
    }
  </h3>
  <p class="leading-6" set:html={description} />
  {
    Astro.slots.has("default") && (
      <ul class="mt-2 list-disc space-y-1 pl-6">
        <slot />
      </ul>
    )
  }
</div>
